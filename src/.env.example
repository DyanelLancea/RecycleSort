# Copy to src/.env for local development. Do not commit real credentials.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Simulated AWS Systems Manager Parameter Store keys (local fallbacks)
SSM_ADMIN_API_KEY=dev-admin-api-key-not-for-production
SSM_JWT_SIGNING_KEY=dev-jwt-signing-key-not-for-production

# SQLAlchemy URL. Local default is SQLite; production will use RDS PostgreSQL.
DATABASE_URL=sqlite:///./recyclesort.sqlite3

# Upload constraints
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
